#!/bin/bash

# Controls the web server that serves the web interface of the benchmark suite.

usage()
{
	cat << EOF
bencherlui is used to start the bencherl UI web server that can be
used to view benchmark results in a web browser. For bencherui to
work, bencherl UI needs to be compiled (make ui).

Usage: bencherlui [OPTION..]
Start or stop the web server that serves bencherl UI.

  -h         display this help and exit
  -u         start the web server that serves bencherl UI (on port 8001, or
             the one in the BENCHERLUI_PORT environment variable)
  -d         stop the web server that serves bencherl UI

For complete documentation, see the README.md file.
EOF
}

if [ "$#" -ne 1 ] ; then
    usage
    exit 1
fi

cd "$( dirname "${BASH_SOURCE[0]}" )"

# The node is named after the bencherl directory, so that the web servers of
# several copies can run on the same host.
NODE="bencherlui_$(pwd | sed 's/[^a-zA-Z0-9]//g')"
NODE_AT_HOST="$NODE@$(hostname -s)"
PORT=${BENCHERLUI_PORT:-8001}

# Runs Erlang code in a temporary node next to the web server's.
ctl()
{
    erl -sname "${NODE}_ctl_$$" -noshell -eval "N = '$NODE_AT_HOST', $1"
}

is_running()
{
    ctl "halt(case net_adm:ping(N) of pong -> 0; pang -> 1 end)."
}

while getopts ":udh" opt; do
  case $opt in
    h)
        usage
        exit 0
        ;;
    u)
        if is_running; then
            echo "The web server is already running."
            exit 1
        fi
        echo "Starting web server..."
        # Started from here, the server finds the results in results/.
        erl -sname "$NODE" -detached -noshell \
            -pa ui/bencherlui/_build/default/lib/*/ebin \
            -bencherlui port "$PORT" \
            -eval "{ok, _} = application:ensure_all_started(bencherlui)."
        # Wait for the application to start, or the node to fail.
        ctl "Wait = fun W(0) -> halt(1);
                        W(I) -> case rpc:call(N, application, which_applications, []) of
                                    Apps when is_list(Apps) ->
                                        case lists:keymember(bencherlui, 1, Apps) of
                                            true -> halt(0);
                                            false -> timer:sleep(500), W(I - 1)
                                        end;
                                    _ -> timer:sleep(500), W(I - 1)
                                end
                    end,
             Wait(20)."
        if [ $? -ne 0 ]; then
            echo "The web server did not start. Has it been built (make ui)?"
            is_running && ctl "rpc:call(N, init, stop, []), halt()."
            exit 1
        fi
        echo "Web server started."
        host=`hostname -f`
        echo "Use your web browser and go to  http://$host:$PORT."
        echo "Use the following command to stop the web server:"
        echo "./bencherlui -d"
        exit 0
        ;;
    d)
        if ! is_running; then
            echo "The web server is not running."
            exit 1
        fi
        echo "Stopping web server..."
        ctl "rpc:call(N, init, stop, []), halt()."
        exit 0
        ;;
    \?)
      echo "Invalid option: -$OPTARG"
      exit 1
      ;;
  esac
done
