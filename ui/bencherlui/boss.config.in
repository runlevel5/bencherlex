[{boss, [
    {path, "BENCHERL_UI_PATH/ChicagoBoss"},
    {applications, [bencherlui]},
    {db_host, "localhost"},
    {vm_sname, "VM_SHORT_NAME"},
    {vm_name, "VM_NAME"},
    {db_port, 1978},
    {db_adapter, mock},
    {log_dir, "log"},
    {session_adapter, mock},
    {session_key, "_boss_session"},
    {session_exp_time, 525600}
]},
{lager, [
    {log_root, "log"},
    {handlers, [
        {lager_file_backend, [{file, "error.log"}, {level, error}]},
        {lager_file_backend, [{file, "console.log"}, {level, info}]}
    ]}
]},
{simple_bridge, [
    {server_name, boss_webserver},
    {handler, boss_simple_bridge_handler},
    {backend, mochiweb},
    {address, "0.0.0.0"},
    {port, 8001},
    {document_root, "./priv"},
    {static_paths, ["static/"]},
    {max_post_size, 100},
    {max_file_size, 100},
    {max_file_in_memory_size, 0},
    {scratch_dir, "./scratch"}
]},
{ bencherlui, [
    {path, "../bencherlui"},
    {base_url, "/"}
]}
].
