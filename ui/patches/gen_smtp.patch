gen_smtp: use crypto:mac/4 and ssl:handshake, as crypto:hmac/3 and ssl:ssl_accept are gone.

diff --git a/src/smtp_util.erl b/src/smtp_util.erl
index 558cbaf..15308b3 100644
--- a/src/smtp_util.erl
+++ b/src/smtp_util.erl
@@ -62,7 +62,7 @@ guess_FQDN() ->
 %% @doc Compute the CRAM digest of `Key' and `Data'
 -spec compute_cram_digest(Key :: binary(), Data :: string()) -> binary().
 compute_cram_digest(Key, Data) ->
-	Bin = crypto:hmac(md5, Key, Data),
+	Bin = crypto:mac(hmac, md5, Key, Data),
 	list_to_binary([io_lib:format("~2.16.0b", [X]) || <<X>> <= Bin]).
 
 %% @doc Generate a seed string for CRAM.
diff --git a/src/socket.erl b/src/socket.erl
index 904a236..bca69cf 100644
--- a/src/socket.erl
+++ b/src/socket.erl
@@ -117,8 +117,7 @@ accept(Socket, Timeout) when is_port(Socket) ->
 accept(Socket, Timeout) ->
 	case ssl:transport_accept(Socket, Timeout) of
 		{ok, NewSocket} ->
-			ssl:ssl_accept(NewSocket),
-			{ok, NewSocket};
+			ssl:handshake(NewSocket);
 		Error -> Error
 	end.
 
@@ -226,7 +225,7 @@ to_ssl_server(Socket, Options) ->
 
 -spec to_ssl_server(Socket :: socket(), Options :: list(), Timeout :: non_neg_integer() | 'infinity') -> {'ok', ssl:socket()} | {'error', any()}.
 to_ssl_server(Socket, Options, Timeout) when is_port(Socket) ->
-	ssl:ssl_accept(Socket, ssl_listen_options(Options), Timeout);
+	ssl:handshake(Socket, ssl_listen_options(Options), Timeout);
 to_ssl_server(_Socket, _Options, _Timeout) ->
 	{error, already_ssl}.
 
