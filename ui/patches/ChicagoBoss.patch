     %%% EXPERIMENTAL %%%
     %% Uncomment the following line if you want LFE support
@@ -82,6 +87,13 @@
     {base_plt_prefix, "rebar3"}
 ]}.
 
+%% OTP 29 warns about constructs that the dependencies still use, such as
+%% catch Expr; do not let that stop the build. Requests, records and the
+%% like are tuples that code calls functions on (Req:path()), which needs
+%% tuple_calls since OTP 21.
+{overrides, [{del, [{erl_opts, [warnings_as_errors]}]},
+             {add, [{erl_opts, [tuple_calls]}]}]}.
+
 {cover_enabled, true}.
 
 {plugins, [rebar3_proper]}.
