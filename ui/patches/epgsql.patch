epgsql: use crypto:mac/4, as crypto:hmac/3 is gone.

diff --git a/src/epgsql_scram.erl b/src/epgsql_scram.erl
index 48eb713..e7049c0 100644
--- a/src/epgsql_scram.erl
+++ b/src/epgsql_scram.erl
@@ -124,7 +124,7 @@ hi1(Str, U, Hi, I) ->
     hi1(Str, U2, Hi1, I - 1).
 
 hmac(Key, Str) ->
-    crypto:hmac(sha256, Key, Str).
+    crypto:mac(hmac, sha256, Key, Str).
 
 h(Str) ->
     crypto:hash(sha256, Str).
