#!/bin/bash

if [ -z "$2" ]; then
	e1="erlc"
	e2="erl"
	e3="epmd"
else
	e1="$2/bin/erlc"
	e2="$2/bin/erl"
	# bin/epmd in an installation, bin/<architecture>/epmd in a build.
	if [ -x "$2/bin/epmd" ]; then
		e3="$2/bin/epmd"
	else
		e3=$(ls "$2"/bin/*/epmd | head -n 1)
	fi
fi

# As bin/firstnode.sh does, with the cookie of the benchmark ($4), which
# Scalaris does not use by default, and the erl arguments of the run ($3).
env BEAMDIR="app/scalaris/ebin" ERLC="$e1" ERL="$e2" EPMD="$e3" \
    app/scalaris/bin/scalarisctl -c "$4" -e "$3 +S$1:$1 -detached -noshell" -m \
    -n firstnode -p 14195 -y 8000 -t first start &

sleep 3s 

