#!/bin/bash

if [ -z $2 ]; then
	e1="erlc"
	e2="erl"
	e3="epmd"
else
	e1="$2/bin/erlc"
	e2="$2/bin/erl"
	# bin/epmd in an installation, bin/<architecture>/epmd in a build.
	if [ -x "$2/bin/epmd" ]; then
		e3="$2/bin/epmd"
	else
		e3=$(ls "$2"/bin/*/epmd | head -n 1)
	fi
fi

hostname=`env hostname -f`

case "$hostname" in
    *.*)
        env BEAMDIR="app/scalaris/ebin" ERLC="$e1" ERL="$e2" EPMD="$e3" \
            app/scalaris/bin/scalarisctl -c "$4" -n firstnode@$hostname stop \
            > /dev/null
        ;;
    *)
        # scalarisctl stops the node from a node with a long name, which a
        # host name without a domain does not allow.
        "$e2" -sname "stop_$$" -setcookie "$4" -noshell \
            -eval "rpc:call('firstnode@$hostname', init, stop, []), halt()."
        ;;
esac
sleep 3
