#!/bin/bash

# Writes the script that starts the Sim-Diasca computing nodes: one on each of
# the first ${6} slave nodes, or, when there are none, one on this host.
# Sim-Diasca does not start them itself (see class_ComputingHostManager), and
# stops them at the end of each simulation, so city_simulation:run/3 runs the
# script before each one.

# The initial states of the simulation: the top-level make extracts them, but
# they may have been removed since (make real-clean does).
initdir=${12}/app/sim-diasca/mock-simulators/city-example/src
for scale in tiny small medium; do
    if [ ! -f $initdir/city-example-instances-version-0.5.4-scale-$scale.init ]; then
        tar xzf $initdir/city-example-instances-version-0.5.4.all.init.tar.gz -C $initdir
        break
    fi
done

OLD_IFS=$IFS
IFS=","

echo "" > ${12}/app/sim-diasca/mock-simulators/city-example/src/sim-diasca-host-candidates-for-scale-benchmarks.txt
echo "" > ${12}/app/sim-diasca/mock-simulators/city-example/src/sim-diasca-host-candidates.txt

# The node name option, as for the master node.
if [ "${13}" = "1" ]; then
    name_option="-name"
else
    name_option="-sname"
fi

# The command that starts the computing node named $1.
schedulers=${1}; erl_args=${3}; cookie=${4}; otp=${7}; extra_code_path=${8}
deps_paths=${9}; erl_env=${10}; erl=${11}; root=${12}
node_cmd()
{
    echo "BENCHERL_ROOT=$root $erl_env $erl $erl_args -setcookie '$cookie' +K true \
        +A 128 +P 1048576 +S$schedulers:$schedulers $name_option $1 -noshell \
        -pa $extra_code_path $deps_paths $root/suite/ebin-$otp \
        $root/bench/city_simulation/ebin-$otp \
        -kernel inet_dist_listen_min 50000 inet_dist_listen_max 55000"
}

script=$root/scratch/city_simulation_nodes.sh
echo "#!/bin/bash" > $script
chmod +x $script

i=1
for node in ${5}; do

    if [[ "$i" -gt "${6}" ]]; then
        break;
    fi

    node=${node:1:-1}
    name=`echo $node | cut -d'@' -f1`
    host=`echo $node | cut -d'@' -f2`

    echo "'$host'." >> ${12}/app/sim-diasca/mock-simulators/city-example/src/sim-diasca-host-candidates-for-scale-benchmarks.txt
    echo "'$host'." >> ${12}/app/sim-diasca/mock-simulators/city-example/src/sim-diasca-host-candidates.txt

    IFS=$OLD_IFS
    if [ "${13}" = "1" ]; then
        cmd=$(node_cmd $node)
    else
        cmd=$(node_cmd $name)
    fi
    printf 'ssh -f %s@%s %q\n' "`whoami`" "$host" "$cmd" >> $script
    IFS=","

    i=$((i+1))
    hosts="$hosts\n'$host'."

done

IFS=$OLD_IFS

if [[ "${6}" -eq "0" ]]; then
    # The name Sim-Diasca gives the computing node of this host for the
    # benchmark's simulation case.
    name="Sim-Diasca_City-example_Benchmarking_Loading_Case-`whoami`"
    cat >> $script << EOF
# Wait until the node of the previous simulation has gone, start the node, and
# wait until it has registered with epmd.
for i in \$(seq 1 30); do
    env $erl_env epmd -names 2>/dev/null | grep -q "^name $name at" || break
    sleep 1
done
$(node_cmd $name) -detached
for i in \$(seq 1 30); do
    env $erl_env epmd -names 2>/dev/null | grep -q "^name $name at" && break
    sleep 1
done
EOF
fi
